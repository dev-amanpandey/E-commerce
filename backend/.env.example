PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Option 1: full URI (recommended)
MONGO_URI=mongodb+srv://<db_user>:<url_encoded_password>@<cluster-host>/?retryWrites=true&w=majority&appName=Cluster0

# Option 2: split values (backend encodes credentials automatically)
# MONGO_HOST=<cluster-host>
# MONGO_USER=<db_user>
# MONGO_PASSWORD=<password>

MONGO_DB_NAME=ecommerce
JWT_SECRET=replace_with_a_strong_secret
